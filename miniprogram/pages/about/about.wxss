.page {
  min-height: 100vh;
  padding: 60rpx 36rpx 80rpx;
}

.head {
  margin-bottom: 48rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.sec {
  margin-bottom: 56rpx;
}

.sec__title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.p {
  line-height: 1.9;
  margin-bottom: 16rpx;
}

.strong {
  color: var(--warn);
}

.warn {
  padding: 28rpx;
  background: var(--warn-soft);
  border-radius: 6rpx;
  border: 1rpx solid rgba(200, 80, 60, 0.3);
}

.ref {
  margin-bottom: 28rpx;
}

.ref__group {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.ref__item {
  line-height: 1.9;
}

.mt {
  margin-top: 16rpx;
}
