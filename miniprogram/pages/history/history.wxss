.page {
  min-height: 100vh;
  padding: 60rpx 36rpx;
}

.head {
  margin-bottom: 48rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  line-height: 2;
}

.mt {
  margin-top: 16rpx;
}

.card {
  padding: 28rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
  margin-bottom: 20rpx;
}

.card__no {
  letter-spacing: 3rpx;
  margin-bottom: 14rpx;
}

.card__row {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.card__idx {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--warn);
  line-height: 1;
}

.card__rank {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.foot {
  margin-top: 60rpx;
}
