<view class="page">
  <view class="head">
    <view class="t-mono t-faint t-sm">ARCHIVE</view>
    <view class="title">往期档案</view>
  </view>

  <view wx:if="{{empty}}" class="empty t-dim">
    <view>还没有任何档案。</view>
    <view class="t-sm mt">完成一次《第七夜》，这里会留下记录。</view>
  </view>

  <view wx:else>
    <view wx:for="{{list}}" wx:key="index" class="card">
      <view class="card__no t-mono t-faint t-sm">CASE · {{item.date}}</view>
      <view class="card__row">
        <view class="card__idx t-mono">{{item.index}}</view>
        <view class="card__meta">
          <view class="card__rank">{{item.rank}}</view>
          <view class="t-dim t-sm">{{item.endingName}} · {{item.quadrant}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="foot" wx:if="{{!empty}}">
    <button class="btn btn--ghost" bindtap="onClear">清除全部记录</button>
  </view>
</view>
