<view class="page">
  <image class="page__bg" src="/images/bg_archive.jpg" mode="aspectFill"></image>
  <view class="page__mask"></view>

  <view class="page__content">
    <view class="brand fade-in">
      <view class="brand__no t-mono">CASE 027</view>
      <view class="brand__name">检茶员</view>
      <view class="brand__sub t-dim">第七夜 · 互动阅读</view>
    </view>

    <view class="hr"></view>

    <view class="notice fade-in">
      <view class="notice__line">你的工作很简单：</view>
      <view class="notice__line">进入一段关系，观察里面的人，</view>
      <view class="notice__line">标记可疑对象。</view>
    </view>

    <view class="actions">
      <button class="btn btn--primary" bindtap="onNew">领取新档案</button>
      <block wx:if="{{hasSave}}">
        <button class="btn" bindtap="onContinue">
          <view>继续上次</view>
          <view class="t-dim t-sm">{{saveInfo}}</view>
        </button>
      </block>
      <button class="btn" bindtap="onHistory">往期档案</button>
      <button class="btn btn--ghost" bindtap="onAbout">关于</button>
    </view>
  </view>
</view>
