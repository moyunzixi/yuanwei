.page {
  min-height: 100vh;
}

/* ===== 揭晓 ===== */
.reveal {
  min-height: 100vh;
  padding: 160rpx 56rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.reveal__no {
  font-size: 24rpx;
  letter-spacing: 6rpx;
  margin-bottom: 60rpx;
}

.reveal__line {
  font-size: 40rpx;
  line-height: 2;
  margin-bottom: 12rpx;
}

.reveal__you {
  margin-top: 60rpx;
  color: var(--warn);
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

.reveal__hint {
  margin-top: 120rpx;
  text-align: center;
  animation: breathe 2.4s ease-in-out infinite;
}

@keyframes breathe {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
}

/* ===== 报告 ===== */
.report {
  height: 100vh;
  padding: 40rpx 36rpx 60rpx;
}

.sec {
  margin-bottom: 64rpx;
}

.sec__no {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.sec__title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.mt {
  margin-top: 20rpx;
}

.index-row {
  display: flex;
  align-items: baseline;
  gap: 28rpx;
}

.index-num {
  font-size: 110rpx;
  font-weight: 700;
  color: var(--warn);
  line-height: 1;
  font-family: 'SF Mono', 'Courier New', monospace;
}

.index-meta {
  flex: 1;
}

.rank {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.radar {
  width: 100%;
}

/* 维度条 */
.dim {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.dim__label {
  width: 180rpx;
  font-size: 27rpx;
}

.dim__bar {
  flex: 1;
  height: 10rpx;
  background: rgba(230, 233, 239, 0.08);
  border-radius: 5rpx;
  overflow: hidden;
}

.dim__fill {
  height: 100%;
  background: var(--warn);
  border-radius: 5rpx;
}

.dim__val {
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--text-dim);
}

/* 回放 */
.replay {
  padding: 20rpx 24rpx;
  background: var(--bg-elev);
  border-left: 4rpx solid var(--accent);
  border-radius: 4rpx;
  margin-bottom: 18rpx;
}

.replay__label {
  color: var(--accent);
  margin-bottom: 6rpx;
}

.replay__text {
  line-height: 1.7;
}

.pat {
  color: var(--text);
  line-height: 1.9;
  font-size: 28rpx;
}

/* 象限 */
.quad {
  padding: 28rpx;
  background: var(--bg-elev);
  border-radius: 6rpx;
  border: 1rpx solid var(--line);
}

.quad__name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.quad__line {
  line-height: 1.8;
}

.match {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.match__name {
  width: 120rpx;
  font-size: 28rpx;
}

.match__bar {
  flex: 1;
  height: 10rpx;
  background: rgba(230, 233, 239, 0.08);
  border-radius: 5rpx;
  overflow: hidden;
}

.match__fill {
  height: 100%;
  background: var(--accent);
  border-radius: 5rpx;
}

.match__val {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--text-dim);
}

/* 结局 */
.ending-line {
  color: var(--text);
  line-height: 2;
  margin-bottom: 16rpx;
}

.cost {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  background: var(--warn-soft);
  border-radius: 4rpx;
}

.closing {
  padding: 40rpx 0;
  border-top: 1rpx solid var(--line);
}

.closing__line {
  line-height: 2;
  font-size: 30rpx;
}

.disclaimer {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.foot {
  padding-bottom: 40rpx;
}
